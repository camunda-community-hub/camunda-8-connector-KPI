    <bpmn:scriptTask id="Activity_1goiwt2" name="getAmount">
      <bpmn:extensionElements>
        <zeebe:script expression="={idx: 1 + floor(random number() * 5), places: [[&#34;Paris&#34;,&#34;France&#34;],[&#34;London&#34;,&#34;UK&#34;],[&#34;Berlin&#34;,&#34;Germany&#34;],[&#34;Madrid&#34;,&#34;Spain&#34;],[&#34;Rome&#34;,&#34;Italy&#34;]], picked: places[idx], amount: floor(1000 + (random number() * 9000)), city: picked[1], country: picked[2]}" resultVariable="amountResult" />
        <zeebe:ioMapping>
          <zeebe:output source="=amountResult.amount" target="amount" />
          <zeebe:output source="=amountResult.city" target="city" />
          <zeebe:output source="=amountResult.country" target="country" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0baismk</bpmn:incoming>
      <bpmn:outgoing>Flow_1ah3t7d</bpmn:outgoing>
    </bpmn:scriptTask>
